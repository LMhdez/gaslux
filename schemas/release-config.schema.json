{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ekimia.fr/libertix/schemas/release-config.schema.json",
  "title": "Libertix release configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mainRelease",
    "distributions"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "mainRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "title",
        "notes"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){1,2}(?:-[0-9A-Za-z.-]+)?$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      }
    },
    "distributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/distribution"
      }
    }
  },
  "$defs": {
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "osReleaseId",
        "grubDisplayName",
        "grubIcon",
        "secureBootMicrosoftAuthorities",
        "description",
        "imageUrl",
        "isoInstaller",
        "isoInstallerFileName",
        "isoInstallerSha256",
        "isoInstallerSizeBytes",
        "sizeInGB"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "osReleaseId": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "grubDisplayName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()+-]{0,79}$"
        },
        "grubIcon": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "secureBootMicrosoftAuthorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "2011",
              "2023"
            ]
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "imageUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "isoInstaller": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "isoInstallerFileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.iso$"
        },
        "isoInstallerSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "isoInstallerSizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sizeInGB": {
          "type": "number",
          "minimum": 20
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "backend",
        "source",
        "firmwareLayouts",
        "secureBoot",
        "bootloader",
        "status",
        "minimumRamMiB",
        "minimumDiskGiB"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "backend": {
          "enum": [
            "debian-squashfs",
            "archiso-cachyos",
            "system76",
            "q4os-native",
            "fedora-atomic"
          ]
        },
        "source": {
          "enum": [
            "casper-squashfs",
            "archiso",
            "pop-live",
            "q4os-native-iso",
            "fedora-atomic-iso"
          ]
        },
        "firmwareLayouts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "bios/mbr",
              "uefi/gpt"
            ]
          }
        },
        "secureBoot": {
          "enum": [
            "ms-shim",
            "unsupported",
            "manual-enrollment"
          ]
        },
        "bootloader": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bios",
            "uefi"
          ],
          "properties": {
            "bios": {
              "enum": [
                "grub",
                "none"
              ]
            },
            "uefi": {
              "enum": [
                "grub",
                "systemd-boot",
                "none"
              ]
            }
          }
        },
        "status": {
          "enum": [
            "released",
            "lab-only",
            "unavailable"
          ]
        },
        "minimumRamMiB": {
          "type": "integer",
          "minimum": 1024
        },
        "minimumDiskGiB": {
          "type": "integer",
          "minimum": 20
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "const": "fedora-atomic"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "properties": {
              "firmwareLayouts": {
                "const": [
                  "uefi/gpt"
                ]
              },
              "bootloader": {
                "properties": {
                  "bios": {
                    "const": "none"
                  },
                  "uefi": {
                    "const": "grub"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "system76"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "properties": {
              "bootloader": {
                "properties": {
                  "uefi": {
                    "const": "systemd-boot"
                  }
                }
              },
              "secureBoot": {
                "const": "unsupported"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "debian-squashfs"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "properties": {
              "source": {
                "const": "casper-squashfs"
              },
              "firmwareLayouts": {
                "const": [
                  "bios/mbr",
                  "uefi/gpt"
                ]
              },
              "secureBoot": {
                "const": "ms-shim"
              },
              "bootloader": {
                "properties": {
                  "bios": {
                    "const": "grub"
                  },
                  "uefi": {
                    "const": "grub"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "distributions": {
            "items": {
              "allOf": [
                {
                  "oneOf": [
                    {
                      "properties": {
                        "id": {
                          "const": "mint"
                        },
                        "osReleaseId": {
                          "const": "linuxmint"
                        }
                      }
                    },
                    {
                      "properties": {
                        "id": {
                          "const": "zorin"
                        },
                        "osReleaseId": {
                          "const": "zorin"
                        }
                      }
                    }
                  ]
                },
                {
                  "not": {
                    "required": [
                      "capabilities"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "distributions": {
            "items": {
              "required": [
                "capabilities"
              ]
            }
          }
        }
      }
    }
  ]
}
