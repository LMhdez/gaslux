        "liveBootAuthorized",
        "QEMU_FD_BACKING_VERIFIED",
        "productionStorageWritesAuthorized",
        "q4osNativeInstallationVerified",
        "sameDiskDualBootVerified",
        "windowsInPlaceRollbackProven",
        "releaseEligible",
        "stable",
        "disposableVmStandingPolicy"
      ]
