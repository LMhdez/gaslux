    {
      "if": {
        "properties": {
          "evidenceLevel": {
            "const": "SOURCE_REFERENCE_ONLY"
          }
        }
      },
      "then": {
        "properties": {
          "iso": {
            "properties": {
              "sha256MatchedThisRun": {
                "const": false
              },
              "observed": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidenceLevel": {
            "const": "MEDIA_HASH_ONLY"
          }
        }
      },
      "then": {
        "properties": {
          "iso": {
            "properties": {
              "sha256MatchedThisRun": {
                "const": true
              },
              "observed": {
                "type": "object"
              }
            }
          }
        }
      }
    }
