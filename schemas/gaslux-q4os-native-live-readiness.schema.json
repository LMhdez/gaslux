        "independentSafetyApproved": {
          "const": false
        },
        "liveBootAuthorized": {
          "const": false
        },
        "QEMU_FD_BACKING_VERIFIED": {
          "const": false
        },
        "productionStorageWritesAuthorized": {
          "const": false
        },
        "q4osNativeInstallationVerified": {
          "const": false
        },
        "sameDiskDualBootVerified": {
          "const": false
        },
        "windowsInPlaceRollbackProven": {
          "const": false
        },
        "releaseEligible": {
          "const": false
        },
        "stable": {
          "const": false
        },
        "disposableVmStandingPolicy": {
          "const": true
