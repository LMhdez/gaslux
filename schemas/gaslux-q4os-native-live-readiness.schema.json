    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 6,
      "items": {
        "enum": [
          "INDEPENDENT_SAFETY_APPROVAL_MISSING",
          "SIGNED_GASLUX_ISO_CATALOG_MISSING",
