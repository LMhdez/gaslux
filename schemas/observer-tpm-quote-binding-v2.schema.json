{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LMhdez/gaslux/blob/main/schemas/observer-tpm-quote-binding-v2.schema.json",
  "title": "Observer detached TPM quote binding proposal v2 (not an attestation receipt)",
  "description": "Strict local consistency proposal, not a signed external attestation. Does not extend or change Observer remote protocol v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "kind",
    "classification",
    "guest_input_authorized",
    "independent_attestation_verified",
    "ak_trust_status",
    "measured_boot_status",
    "vm_binding_status",
    "execution_domain_status",
    "transaction_id",
    "session_id",
    "request_id",
    "nonce",
    "vm_uuid",
    "distribution_id",
    "distribution_version",
    "iso_sha256",
    "policy_id",
    "policy_version",
    "policy_sha256",
    "trust_anchor_id",
    "request_sha256",
    "response_sha256",
    "quote_sha256",
    "signature_sha256",
    "challenge_sha256",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "contract_version": {
      "const": 2
    },
    "kind": {
      "const": "detached-tpm-quote-binding-proposal"
    },
    "classification": {
      "const": "NOT_INDEPENDENT"
    },
    "guest_input_authorized": {
      "const": false
    },
    "independent_attestation_verified": {
      "const": false
    },
    "ak_trust_status": {
      "const": "AK_TRUST_UNVERIFIED"
    },
    "measured_boot_status": {
      "const": "MEASURED_BOOT_POLICY_UNVERIFIED"
    },
    "vm_binding_status": {
      "const": "VM_BINDING_UNVERIFIED"
    },
    "execution_domain_status": {
      "const": "EXECUTION_DOMAIN_UNVERIFIED"
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "vm_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "distribution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "distribution_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "iso_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trust_anchor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "response_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "quote_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "challenge_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
