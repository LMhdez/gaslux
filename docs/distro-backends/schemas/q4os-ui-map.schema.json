{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gaslux Q4OS installer observed-state evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "distribution",
    "iso",
    "status",
    "sessions",
    "states",
    "stopReason"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "distribution": {
      "const": "q4os"
    },
    "iso": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "source"
      ],
      "properties": {
        "version": {
          "const": "6.10-r2"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "status": {
      "enum": [
        "pending",
        "partial",
        "reproduced"
      ]
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "runUrl",
          "artifactUrl",
          "isoVerified",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "runUrl": {
            "type": "string",
            "format": "uri"
          },
          "artifactUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "isoVerified": {
            "type": "boolean"
          },
          "result": {
            "enum": [
              "pending",
              "failed",
              "passed"
            ]
          }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "title",
          "status",
          "before",
          "after",
          "action",
          "locators",
          "resolution",
          "scale",
          "controls",
          "timeoutSeconds",
          "screenshot",
          "screenshotSha256",
          "sessionIds",
          "validation",
          "errors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "observed",
              "reproduced"
            ]
          },
          "before": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "locators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type",
                "value",
                "verified"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "qt-object",
                    "accessibility",
                    "ocr",
                    "image",
                    "coordinates"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "verified": {
                  "const": true
                },
                "bounds": {
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          "resolution": {
            "type": "object",
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutSeconds": {
            "type": "number",
            "minimum": 0
          },
          "screenshot": {
            "type": "string",
            "minLength": 1
          },
          "screenshotSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sessionIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "stopReason": {
      "type": "string",
      "minLength": 1
    }
  }
}
